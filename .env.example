# ProofLoop local configuration. Copy to .env (setup.ps1 does this for you).
# No API keys or secrets are needed - everything runs on this machine by default.

# Where ProofLoop stores its database, sandboxes, reports and logs (relative to the project folder).
PROOFLOOP_DATA_DIR=data

# Local LLM (Ollama). Must be a localhost address unless PROOFLOOP_ALLOW_REMOTE_OLLAMA=true.
PROOFLOOP_OLLAMA_URL=http://127.0.0.1:11434
PROOFLOOP_OLLAMA_MODEL=qwen2.5:3b
PROOFLOOP_OLLAMA_TIMEOUT_SECONDS=180
PROOFLOOP_OLLAMA_MAX_RETRIES=2

# auto = local LLM when available, otherwise deterministic rules | llm = LLM only | rules = never use the LLM
PROOFLOOP_INTERPRETER_MODE=auto
PROOFLOOP_LLM_ENABLED=true
PROOFLOOP_LLM_NARRATIVE_ENABLED=false

# Optional cloud model (NVIDIA NIM, free developer key from build.nvidia.com).
# A key here does NOT turn the cloud on: an administrator must switch Settings -> Model to "Cloud"
# and accept the data notice. When active, task text and the data the AI agent reads leave this machine.
# PROOFLOOP_CLOUD_API_KEY=nvapi-...
PROOFLOOP_CLOUD_BASE_URL=https://integrate.api.nvidia.com/v1
PROOFLOOP_CLOUD_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
PROOFLOOP_CLOUD_TIMEOUT_SECONDS=120

# Sign-in sessions and brute-force protection
PROOFLOOP_SESSION_TTL_HOURS=12
PROOFLOOP_MAX_FAILED_LOGINS=5
PROOFLOOP_LOCKOUT_MINUTES=5

PROOFLOOP_LOG_LEVEL=INFO
